{
  "name": "student-task-manager",
  "version": "1.0.0",
  "description": "Student Task Management System - Full Stack College Project",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend --include=dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run install:all && npm run build:frontend",
    "start": "node backend/src/server.js",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "db:view": "npm run db:view --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "react",
    "vite",
    "express",
    "sqlite",
    "task-management",
    "college-project"
  ],
  "author": "",
  "license": "ISC"
}
